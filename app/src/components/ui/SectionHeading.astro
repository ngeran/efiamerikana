---
/**
 * Shared section heading block: the h2 and an optional intro paragraph.
 * (The old nav-label chip was removed — with the fixed scroll-spy nav
 * highlighting the current section, the chip only duplicated it.)
 */
interface Props {
  id: string;
  heading: string;
  intro?: string | null;
  align?: 'left' | 'center';
  tone?: 'dark' | 'light';
}

const { id, heading, intro, align = 'left', tone = 'dark' } = Astro.props;

const alignment = align === 'center' ? 'items-center text-center' : 'items-start text-left';
// Full-opacity intros: translucent charcoal fails AA on the saturated
// pink section background (and marginal on cream).
const introTone = tone === 'light' ? 'text-white/75' : 'text-charcoal';
---

<div class:list={['flex flex-col gap-4', alignment]}>
  <h2 id={id} class="font-display text-section leading-[1.05]">{heading}</h2>
  {
    intro && (
      <p
        class={`max-w-2xl text-base leading-relaxed sm:text-lg ${introTone} ${align === 'center' ? 'mx-auto' : ''}`}
      >
        {intro}
      </p>
    )
  }
</div>
