---
/**
 * Shared section heading block: small uppercase label chip (from the nav
 * label in CMS settings), the h2, and an optional intro paragraph.
 */
interface Props {
  id: string;
  label?: string;
  heading: string;
  intro?: string | null;
  align?: 'left' | 'center';
  tone?: 'dark' | 'light';
}

const { id, label, heading, intro, align = 'left', tone = 'dark' } = Astro.props;

const alignment = align === 'center' ? 'items-center text-center' : 'items-start text-left';
// Solid chips + full-opacity intros: translucent charcoal fails AA on the
// saturated pink section background (and marginal on cream).
const labelTone = tone === 'light' ? 'bg-white/10 text-white' : 'bg-charcoal text-cream';
const introTone = tone === 'light' ? 'text-white/75' : 'text-charcoal';
---

<div class:list={['flex flex-col gap-4', alignment]}>
  {
    label && (
      <p
        class={`rounded-full px-3 py-1 font-label text-xs font-semibold tracking-[0.18em] uppercase ${labelTone}`}
      >
        {label}
      </p>
    )
  }
  <h2 id={id} class="font-display text-section leading-[1.05]">{heading}</h2>
  {
    intro && (
      <p
        class={`max-w-2xl text-base leading-relaxed sm:text-lg ${introTone} ${align === 'center' ? 'mx-auto' : ''}`}
      >
        {intro}
      </p>
    )
  }
</div>
