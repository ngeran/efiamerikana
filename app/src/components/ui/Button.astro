---
/**
 * Shared button primitive. Variants are chosen so the label always keeps
 * AA contrast on the section backgrounds they are used with:
 *
 *  - `dark`    charcoal bg, yellow label  (on yellow / cream sections)
 *  - `outline` charcoal border + label    (on yellow / cream sections)
 *  - `yellow`  yellow bg, charcoal label  (on dark / red sections)
 */
interface Props {
  href: string;
  variant?: 'dark' | 'solid' | 'outline' | 'yellow';
  class?: string;
}

const { href, variant = 'dark', class: className = '' } = Astro.props;

const variants: Record<NonNullable<Props['variant']>, string> = {
  dark: 'bg-charcoal text-brand-yellow hover:bg-charcoal/85 active:bg-charcoal',
  solid: 'bg-charcoal text-white hover:bg-charcoal/85 active:bg-charcoal',
  outline: 'border-2 border-charcoal text-charcoal hover:bg-charcoal/5 active:bg-charcoal/10',
  yellow: 'bg-brand-yellow text-charcoal hover:bg-brand-yellow/85 active:bg-brand-yellow',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center gap-2 rounded-full px-6 py-3 font-ui text-sm font-bold tracking-wider uppercase transition-colors duration-200',
    variants[variant],
    className,
  ]}
>
  <slot />
</a>
