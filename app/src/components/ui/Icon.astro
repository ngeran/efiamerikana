export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;
---

<!-- eslint-disable astro/no-set-html-directive (audited: icons is a compile-time constant map of static SVG strings; no dynamic content reaches this sink) -->
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={icons[name]}
/>
<!-- eslint-enable astro/no-set-html-directive -->
