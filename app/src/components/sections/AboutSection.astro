---
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import type { Locale } from '../../i18n/config';
import { getAbout } from '../../utils/content';
import { resolveImage } from '../../utils/media';

interface Props {
  locale: Locale;
  label?: string;
}

const { label } = Astro.props;
const data = await getAbout(Astro.props.locale);

const image = resolveImage(data.image);
---

<section id="about" aria-labelledby="about-heading" class="w-full bg-charcoal text-cream">
  <div class="shell grid items-center gap-10 py-16 sm:py-20 lg:grid-cols-2 lg:gap-16 lg:py-28">
    <div class="flex flex-col items-start">
      <SectionHeading id="about-heading" label={label} heading={data.heading} />
      <div class="mt-6 space-y-5">
        {
          data.paragraphs.map((paragraph) => (
            <p class="max-w-xl text-base leading-relaxed text-cream/85 sm:text-lg">{paragraph}</p>
          ))
        }
      </div>
      {
        data.pullQuote && (
          <blockquote class="mt-8 border-l-4 border-brand-pink pl-5 font-display text-xl leading-snug text-brand-yellow italic sm:text-2xl">
            {data.pullQuote}
          </blockquote>
        )
      }
      {
        data.cta && (
          <div class="mt-9">
            <Button href={data.cta.href} variant="yellow">
              {data.cta.label}
            </Button>
          </div>
        )
      }
    </div>

    <div class="order-last lg:order-first">
      <Image
        src={image}
        alt={data.imageAlt}
        widths={[480, 800]}
        sizes="(min-width: 1024px) 45vw, 90vw"
        class="aspect-square w-full rounded-[2rem] object-cover shadow-xl ring-4 ring-white/10"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>
