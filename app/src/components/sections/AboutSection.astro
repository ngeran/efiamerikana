---
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import type { Locale } from '../../i18n/config';
import { getAbout } from '../../utils/content';
import { resolveImage } from '../../utils/media';

interface Props {
  locale: Locale;
  label?: string;
}

const { label } = Astro.props;
const data = await getAbout(Astro.props.locale);

const image = resolveImage(data.image);
---

<section
  id="about"
  aria-labelledby="about-heading"
  class="defer-paint w-full bg-charcoal text-cream"
>
  <div class="shell grid items-center gap-10 py-16 sm:py-20 lg:grid-cols-2 lg:gap-16 lg:py-28">
    <div class="flex flex-col items-center text-center lg:items-start lg:text-left">
      <div class="reveal">
        <SectionHeading id="about-heading" label={label} heading={data.heading} />
      </div>
      <div class="mt-6 space-y-5">
        {
          data.paragraphs.map((paragraph, index) => (
            <p
              class="reveal max-w-xl text-base leading-relaxed text-cream/85 sm:text-lg"
              style={`--reveal-delay: ${0.06 + index * 0.05}s`}
            >
              {paragraph}
            </p>
          ))
        }
      </div>
      {
        data.pullQuote && (
          <blockquote
            class="reveal mt-8 max-w-xl border-l-4 border-brand-pink pl-5 text-left font-display text-xl leading-snug text-brand-yellow italic sm:text-2xl"
            style="--reveal-delay: 0.18s"
          >
            {data.pullQuote}
          </blockquote>
        )
      }
      {
        data.cta && (
          <div class="reveal mt-9" style="--reveal-delay: 0.24s">
            <Button href={data.cta.href} variant="yellow">
              {data.cta.label}
            </Button>
          </div>
        )
      }
    </div>

    <!--
      Same portrait ratio and same max width as the Hero photo (both read from
      --portrait), so the two match as the brief requires. `mx-auto` keeps it
      centred once the column is wider than the cap. `parallax-drift` gives it
      the same slow independent motion as the Hero portrait so the two photos
      that the brief pairs together also move alike.
    -->
    <div class="order-last mx-auto w-full max-w-[24rem] lg:order-first lg:mx-0">
      <Image
        src={image}
        alt={data.imageAlt}
        width={384}
        height={480}
        widths={[384, 768, 1152]}
        sizes="(min-width: 1024px) 24rem, min(100vw - 2.5rem, 24rem)"
        class="portrait-media parallax-drift rounded-[2rem] shadow-xl ring-4 ring-white/10"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>
