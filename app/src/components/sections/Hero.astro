---
import { Image } from 'astro:assets';
import Icon, { type IconName } from '../ui/Icon.astro';
import type { Locale } from '../../i18n/config';
import { translator } from '../../i18n/ui';
import { getContact, getHero } from '../../utils/content';
import { resolveImage } from '../../utils/media';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const data = await getHero(locale);
const contact = await getContact(locale);
const socials = contact.socials;
const image = resolveImage(data.image);
const t = translator(locale).hero;
---

<section
  id="hero"
  class="hero relative flex min-h-[min(600px,100svh)] w-full overflow-hidden bg-brand-yellow"
>
  <!-- MAIN CONTENT AREA (YELLOW) -->
  <div class="flex-1 py-10 sm:py-12 lg:py-20">
    <div
      class="hero-content shell relative z-10 grid items-center gap-10 lg:grid-cols-[24rem_1fr] lg:gap-14"
    >
      <!-- IMAGE CONTAINER -->
      <div class="relative z-10 mx-auto w-full max-w-[24rem]">
        <Image
          src={image}
          alt={data.imageAlt}
          width={384}
          height={480}
          widths={[384, 768, 1152]}
          sizes="(min-width: 1024px) 24rem, min(100vw - 2.5rem, 24rem)"
          class="portrait-media parallax-drift rounded-[2.5rem] shadow-2xl"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <!-- TEXT CONTENT -->
      <div class="flex flex-col items-center text-center lg:items-start lg:text-left lg:pr-32">
        <p class="reveal font-display text-xl tracking-tight sm:text-2xl">
          {data.eyebrow}
        </p>

        <h1
          id="hero-heading"
          class="reveal mt-1 font-display text-[length:var(--text-hero-name)] leading-[1.1] tracking-tight text-balance text-brand-pink"
          style="--reveal-delay: 0.06s"
        >
          {data.heading}
        </h1>

        <div class="mt-6 h-[2px] w-20 bg-charcoal/20 mx-auto lg:mx-0" aria-hidden="true"></div>

        {
          (data.headingAccent || data.tagline) && (
            <div
              class="reveal mt-6 space-y-1 font-ui text-base font-bold tracking-tight sm:text-lg"
              style="--reveal-delay: 0.12s"
            >
              {data.headingAccent && <p>{data.headingAccent}</p>}
              {data.tagline && <p>{data.tagline}</p>}
            </div>
          )
        }

        {
          data.supporting && (
            <p
              class="reveal mt-8 font-sans text-sm italic opacity-80 sm:text-base"
              style="--reveal-delay: 0.16s"
            >
              {data.supporting}
            </p>
          )
        }

        <!-- Social Icons -->
        <div class="reveal mt-10 flex justify-center gap-4 lg:justify-start" style="--reveal-delay: 0.2s">
          {
            socials.map((social) => {
              let iconBg = 'bg-black';
              if (social.icon === 'tiktok') {
                iconBg = 'bg-gradient-to-br from-black to-pink-500';
              } else if (social.icon === 'instagram') {
                iconBg = 'bg-gradient-to-br from-purple-600 via-pink-500 to-orange-400';
              }

              return (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label}
                  class={`flex h-12 w-12 items-center justify-center rounded-full transition-transform hover:scale-110 shadow-lg ${iconBg}`}
                >
                  <Icon name={social.icon as IconName} class="h-6 w-6 fill-white text-white" />
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>

  <!-- SIDEBAR RAIL -->
  <div class="hero-rail absolute inset-y-0 right-0 z-20 hidden lg:flex">
    <div class="w-[var(--rail-red-w)] shrink-0 bg-brand-red"></div>
    <div class="flex flex-1 flex-col items-center justify-center bg-brand-pink">
      <a
        href="#videos"
        data-hero-rail-cta
        class="group flex flex-col items-center gap-8 translate-x-[var(--rail-align-x,0px)] no-underline transition-transform hover:scale-105"
      >
        <span class="max-w-[12ch] text-center font-display text-xl leading-tight text-charcoal">
          {t.viewPortfolio}
        </span>

        <div
          data-hero-rail-button
          class="relative flex h-20 w-20 items-center justify-center rounded-full bg-black shadow-2xl ring-8 ring-brand-yellow/20 hover:ring-brand-yellow/40 transition-all duration-300"
        >
          <div
            class="ml-2 h-0 w-0 border-t-[12px] border-b-[12px] border-l-[20px] border-t-transparent border-b-transparent border-l-brand-yellow"
          >
          </div>
        </div>
      </a>
    </div>
  </div>
</section>

<!-- 
  MOBILE/TABLET BOTTOM BAR 
  Removed `sm:flex-row` and `sm:justify-between` to ensure it stays a centered vertical stack 
  on all phones (iPhones) and tablets.
-->
<a
  href="#videos"
  data-hero-cta
  class="group flex w-full flex-col items-center justify-center gap-4 border-t border-black/5 bg-brand-pink p-5 text-center no-underline transition-colors hover:bg-brand-pink/90 lg:hidden"
>
  <span class="font-display text-lg text-charcoal">{t.viewPortfolio}</span>
  <span
    data-hero-cta-button
    class="flex h-12 w-12 shrink-0 translate-x-[var(--cta-align-x,0px)] items-center justify-center rounded-full bg-black shadow-lg ring-4 ring-brand-yellow/10 transition-transform group-hover:scale-105"
  >
    <span
      class="ml-1 h-0 w-0 border-t-[8px] border-b-[8px] border-l-[14px] border-t-transparent border-b-transparent border-l-brand-yellow"
    ></span>
  </span>
</a>

<script>
  // 1. RAIL WIDTH MEASUREMENT (Controls how far left the red stripe goes)
  const hero = document.querySelector<HTMLElement>('.hero');
  const label = document.querySelector<HTMLElement>('[data-email-label]');

  if (hero && label) {
    const wide = window.matchMedia('(min-width: 1024px)');

    const measure = () => {
      if (!wide.matches) {
        hero.style.removeProperty('--rail-w');
        return;
      }
      if (label.offsetParent === null) return;
      
      const closerOffset = 200; 
      const width = (document.documentElement.clientWidth - label.getBoundingClientRect().left) + closerOffset;
      
      if (width > 0) hero.style.setProperty('--rail-w', `${Math.round(width)}px`);
    };

    let queued = false;
    const remeasure = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        measure();
      });
    };

    remeasure();
    window.addEventListener('resize', remeasure, { passive: true });
    window.addEventListener('orientationchange', remeasure);
    wide.addEventListener('change', remeasure);
    document.fonts?.ready.then(remeasure);
  }

  // 2. BUTTON ALIGNMENT (Positions the play button horizontally)
  const emailIcon =
    document.querySelector<HTMLElement>('[data-email-icon]') ??
    document.querySelector<HTMLElement>('[data-email-label]')?.closest<HTMLElement>('a, button') ??
    null;

  interface AlignTarget {
    move: HTMLElement;
    measure: HTMLElement;
    cssVar: string;
    offset: number; // New: allows specific nudging per target
    disableOnMobile: boolean; // New: prevents mobile centering from breaking
  }

  const alignTargets: AlignTarget[] = [];
  const ctaButton = document.querySelector<HTMLElement>('[data-hero-cta-button]');
  if (ctaButton) alignTargets.push({ move: ctaButton, measure: ctaButton, cssVar: '--cta-align-x', offset: 0, disableOnMobile: true });

  const railCta = document.querySelector<HTMLElement>('[data-hero-rail-cta]');
  const railButton = document.querySelector<HTMLElement>('[data-hero-rail-button]');
  if (railCta && railButton) alignTargets.push({ move: railCta, measure: railButton, cssVar: '--rail-align-x', offset: 10, disableOnMobile: false });

  if (emailIcon && alignTargets.length > 0) {
    const alignAll = () => {
      const iconRect = emailIcon.getBoundingClientRect();
      const iconCenter = iconRect.left + iconRect.width / 2;
      const isMobile = window.innerWidth < 1024;

      for (const { move, measure, cssVar, offset, disableOnMobile } of alignTargets) {
        if (move.offsetParent === null || (isMobile && disableOnMobile)) {
          move.style.setProperty(cssVar, '0px'); // Keep it centered on mobile
          continue;
        }
        
        move.style.setProperty(cssVar, '0px');
        const measureRect = measure.getBoundingClientRect();
        
        /**
         * Subtracting the offset pushes the button to the left.
         * rail target has 10px offset here.
         */
        const delta = (iconCenter - (measureRect.left + measureRect.width / 2)) - offset;
        move.style.setProperty(cssVar, `${Math.round(delta)}px`);
      }
    };

    let alignQueued = false;
    const remeasureAlign = () => {
      if (alignQueued) return;
      alignQueued = true;
      requestAnimationFrame(() => {
        alignQueued = false;
        alignAll();
      });
    };

    remeasureAlign();
    window.addEventListener('resize', remeasureAlign, { passive: true });
    window.addEventListener('orientationchange', remeasureAlign);
    document.fonts?.ready.then(remeasureAlign);
  }
</script>
