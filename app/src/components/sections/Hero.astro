---
import { Image } from 'astro:assets';
import Icon, { type IconName } from '../ui/Icon.astro';
import type { Locale } from '../../i18n/config';
import { getContact, getHero } from '../../utils/content';
import { resolveImage } from '../../utils/media';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const data = await getHero(locale);
const contact = await getContact(locale);
const socials = contact.socials;
const image = resolveImage(data.image);

/**
 * Sidebar sizing, explained:
 * --shell-max:   80rem  — must match .shell's max-width in global.css
 * --shell-pad:   2.5rem — must match .shell's xl+ inline padding
 * --sidebar-min: 340px  — red stripe (80px) + pink column's comfortable
 *                         minimum (260px), i.e. the narrowest the rail
 *                         ever gets, on laptop-width screens.
 *
 * width = max(sidebar-min, half the leftover space once the shell caps
 * out at 80rem, plus the shell's own edge padding).
 *
 * ASSUMPTION: your header/nav renders "EMAIL ME" inside the same .shell
 * container as every other section. If it uses a different max-width or
 * padding, this won't line up — send over the header component and I'll
 * correct the constants above.
 */
const sidebarWidth = 'max(340px, calc((100vw - 80rem) / 2 + 2.5rem))';
---

<section
  id="hero"
  class="relative flex min-h-[600px] w-full overflow-hidden bg-brand-yellow"
>
  <!-- MAIN CONTENT AREA (YELLOW) -->
  <div class="flex-1 py-12 lg:py-20" style={`--sidebar-w: ${sidebarWidth};`}>
    <div
      class="shell relative z-10 grid items-center gap-10 lg:grid-cols-[24rem_1fr] lg:gap-14"
      style="padding-right: max(1.25rem, var(--sidebar-w, 0px));"
    >
      <!-- IMAGE CONTAINER — fixed 384×480, immune to grid track resizing -->
      <div class="relative z-10 mx-auto shrink-0" style="width: 384px; height: 480px;">
        <Image
          src={image}
          alt={data.imageAlt}
          width={384}
          height={480}
          widths={[384, 768]}
          sizes="384px"
          class="h-[480px] w-[384px] rounded-[2.5rem] object-cover shadow-2xl"
          style="width: 384px; height: 480px;"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <!-- TEXT CONTENT -->
      <div class="flex flex-col items-start text-charcoal">
        <!-- Username/Handle -->
        <p class="font-display text-2xl tracking-tight sm:text-3xl">
          {data.eyebrow}
        </p>

        <!-- Display Name (Pink) -->
        <h1
          id="hero-heading"
          class="mt-1 font-display text-hero leading-[0.92] tracking-tight text-brand-pink"
        >
          {data.heading}
          {data.headingAccent && <span class="block">{data.headingAccent}</span>}
        </h1>

        <!-- Divider -->
        <div class="mt-8 h-[3px] w-24 bg-charcoal/20" aria-hidden="true"></div>

        <!-- Roles -->
        <div class="mt-8 space-y-1 font-ui text-xl font-bold tracking-tight sm:text-2xl">
          <p>Greek-American Home Cook</p>
          <p>Food • Lifestyle • UGC Content</p>
        </div>

        <!-- Tagline (Italic) -->
        {
          data.supporting && (
            <p class="mt-12 font-sans text-lg italic opacity-80 sm:text-xl">{data.supporting}</p>
          )
        }

        <!-- Social Icons (Black Circles) -->
        <div class="mt-10 flex gap-4">
          {
            socials.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="flex h-12 w-12 items-center justify-center rounded-full bg-black transition-transform hover:scale-110"
              >
                <Icon name={social.icon as IconName} class="h-6 w-6 fill-white text-white" />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!--
    SIDEBAR RAIL (Desktop)
    `absolute` against the <section> above (which is `position: relative`),
    not `fixed` against the viewport — so it spans exactly the hero's own
    height and scrolls away with it, never overlapping content in any
    other section. Left edge aligns to the .shell boundary (see
    sidebarWidth comment above), and its width grows to fill the gutter
    that opens up once the shell hits its 80rem cap on large screens.
  -->
  <div
    class="absolute inset-y-0 right-0 z-20 hidden lg:flex"
    style={`width: ${sidebarWidth};`}
  >
    <!-- Red Stripe -->
    <div class="w-[80px] shrink-0 bg-brand-red"></div>

    <!-- Pink Sidebar: fills whatever remains of the computed width -->
    <div class="flex flex-1 flex-col items-center justify-center bg-brand-pink">
      <a
        href="#portfolio"
        class="group flex flex-col items-center gap-8 no-underline transition-transform hover:scale-105"
      >
        <span class="font-display text-xl leading-tight text-charcoal text-center">
          view my<br />portfolio
        </span>

        <!-- 3D Style Play Button -->
        <div
          class="relative flex h-16 w-16 items-center justify-center rounded-full bg-black shadow-xl ring-6 ring-black/10"
        >
          <div
            class="ml-1 h-0 w-0 border-t-[10px] border-b-[10px] border-l-[16px] border-t-transparent border-b-transparent border-l-white"
          >
          </div>
        </div>
      </a>
    </div>
  </div>
</section>

<!-- Mobile Portfolio Call-to-Action (Stays visible on scroll/mobile) -->
<div class="flex w-full items-center justify-between border-t border-black/5 bg-brand-pink p-5 lg:hidden">
  <span class="font-display text-xl text-charcoal">view my portfolio</span>
  <div class="flex h-10 w-10 items-center justify-center rounded-full bg-black">
    <div
      class="ml-1 h-0 w-0 border-t-[6px] border-b-[6px] border-l-[10px] border-t-transparent border-b-transparent border-l-white"
    >
    </div>
  </div>
</div>
