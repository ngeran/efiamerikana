---
import SectionHeading from '../ui/SectionHeading.astro';
import PictureCard from '../media/PictureCard.astro';
import { translator } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';
import { getPictureSection, getPictures } from '../../utils/content';

interface Props {
  locale: Locale;
  label?: string;
}

const { locale, label } = Astro.props;
const data = await getPictureSection(locale);
const pictures = await getPictures(locale);
const t = translator(locale).pictures;

/**
 * Layout differs only in card sizing and the matching `sizes` hint — the hint
 * has to describe the real rendered width or the browser picks the wrong
 * image candidate. PictureCard owns everything else.
 *
 * RAIL_CARD widths are computed, not approximated: each breakpoint fixes how
 * many cards are visible at once and the width formula
 * `calc((100% - (n-1)*gap) / n)` divides the rail's content box evenly across
 * exactly that many cards, matching gap-4 (1rem) on the <ul> below. RAIL_SIZES
 * mirrors the same breakpoints so the browser requests the right image size.
 *
 * Below `sm` only one card is visible and it must sit centered on screen.
 * Centering is done with the rail's own `px-8` padding + `snap-center` on the
 * card — NOT `justify-center`, which on an overflowing flex rail shoves the
 * first cards past the unreachable left edge (a data-loss alignment bug).
 * The mobile width is viewport-relative (`100vw-4rem`) so it lands exactly
 * between the two 2rem gutters; % would resolve against the padded content
 * box and end up off-center. From `sm` up, cards tile flush with
 * `justify-start` + `snap-start`.
 */
const GRID_CARD = 'aspect-[4/5.5] w-full max-w-[450px] mx-auto';
const GRID_SIZES =
  '(min-width: 1280px) 20vw, (min-width: 1024px) 25vw, (min-width: 768px) 33vw, 100vw';
const RAIL_CARD =
  'aspect-[4/5.5] w-[calc(100vw-4rem)] snap-center sm:w-[calc((100%-1rem)/2)] sm:snap-start lg:w-[calc((100%-2rem)/3)] xl:w-[calc((100%-3rem)/4)] 2xl:w-[calc((100%-4rem)/5)] shrink-0';
const RAIL_SIZES =
  '(min-width: 1536px) 20vw, (min-width: 1280px) 25vw, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, calc(100vw - 4rem)';
---

<section
  id="pictures"
  aria-labelledby="pictures-heading"
  class="defer-paint w-full overflow-x-hidden bg-brand-pink text-charcoal"
>
  <div class="shell pt-16 sm:pt-20 lg:pt-24">
    <SectionHeading id="pictures-heading" label={label} heading={data.heading} intro={data.intro} />
  </div>

  <div class="w-full pb-16 sm:pb-20 lg:pb-24">
    <!--
      Scroll rail: arrows are sm-and-up only — on phones a finger swipe is
      the native gesture and the arrows would cover the centered card's
      gutters.
    -->
    {
      pictures.length === 0 ? (
        <div class="shell">
          <p class="mt-10 text-charcoal/60">—</p>
        </div>
      ) : data.layout === 'grid' ? (
        <ul
          role="list"
          class="mt-10 grid grid-cols-1 gap-4 px-4 sm:grid-cols-2 sm:px-6 md:grid-cols-3 lg:grid-cols-4 lg:px-8 xl:grid-cols-5 2xl:grid-cols-6"
          data-pictures
        >
          {pictures.map((picture, index) => (
            <PictureCard
              picture={picture}
              locale={locale}
              cardId={`grid-${index}`}
              class={GRID_CARD}
              sizes={GRID_SIZES}
              showDetailsButton={data.showDetailsButton}
              enableHoverPreview={data.enableHoverPreview}
              enableClickToReveal={data.enableClickToReveal}
            />
          ))}
        </ul>
      ) : (
        <div class="relative mt-10 w-full" data-picture-rail-wrap>
          <button
            type="button"
            data-rail-scroll="-1"
            aria-label={t.prev}
            class="absolute top-1/2 left-2 z-20 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-charcoal/20 bg-white/80 text-charcoal backdrop-blur-md transition-all duration-300 hover:scale-110 hover:bg-black hover:text-white sm:left-4 sm:flex sm:h-12 sm:w-12 lg:left-6"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M15 18l-6-6 6-6" />
            </svg>
          </button>
          <button
            type="button"
            data-rail-scroll="1"
            aria-label={t.next}
            class="absolute top-1/2 right-2 z-20 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-charcoal/20 bg-white/80 text-charcoal backdrop-blur-md transition-all duration-300 hover:scale-110 hover:bg-black hover:text-white sm:right-4 sm:flex sm:h-12 sm:w-12 lg:right-6"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M9 18l6-6-6-6" />
            </svg>
          </button>

          <ul
            role="list"
            data-pictures
            data-rail
            tabindex="0"
            aria-label={t.railLabel}
            class="no-scrollbar flex snap-x snap-mandatory justify-start gap-4 overflow-x-auto scroll-smooth px-8 pb-2"
          >
            {pictures.map((picture, index) => (
              <PictureCard
                picture={picture}
                locale={locale}
                cardId={`rail-${index}`}
                class={RAIL_CARD}
                sizes={RAIL_SIZES}
                showDetailsButton={data.showDetailsButton}
                enableHoverPreview={data.enableHoverPreview}
                enableClickToReveal={data.enableClickToReveal}
              />
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

<script>
  document.addEventListener('click', (event) => {
    const toggle = (event.target as HTMLElement).closest<HTMLButtonElement>(
      '[data-picture-toggle]',
    );
    if (!toggle) return;
    const card = toggle.closest<HTMLElement>('[data-picture-card]');
    if (!card) return;
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    card.dataset.open = String(open);
    // Labels come from data-* attributes so this script holds no user-facing strings.
    const label = toggle.dataset[open ? 'labelHide' : 'labelShow'];
    if (label) toggle.setAttribute('aria-label', label);
  });

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  // ------------------------------------------------------------------
  // Endless rail navigation: index-based rather than raw pixel scrollBy,
  // so "next" past the last card wraps to the first (and vice versa)
  // instead of stopping — the arrows are always active, never disabled.
  // ------------------------------------------------------------------
  for (const wrap of document.querySelectorAll<HTMLElement>('[data-picture-rail-wrap]')) {
    const rail = wrap.querySelector<HTMLElement>('[data-rail]');
    if (!rail) continue;

    const cards = () => Array.from(rail.querySelectorAll<HTMLElement>('[data-picture-card]'));

    // Which card the rail is currently parked closest to, used as the base
    // for the next/prev step so a manual swipe stays in sync with the arrows.
    const currentIndex = () => {
      const list = cards();
      if (list.length === 0) return 0;
      let closest = 0;
      let closestDist = Infinity;
      list.forEach((card, i) => {
        const dist = Math.abs(card.offsetLeft - rail.offsetLeft - rail.scrollLeft);
        if (dist < closestDist) {
          closestDist = dist;
          closest = i;
        }
      });
      return closest;
    };

    // Below `sm` the visible card is center-snapped with margin either side
    // (see RAIL_CARD); from `sm` up, cards tile flush against the row start.
    // The scroll target math has to match whichever mode is active, or the
    // programmatic scroll lands short/long of where CSS snap actually settles.
    const centered = window.matchMedia('(max-width: 639.98px)');

    const scrollToIndex = (index: number) => {
      const list = cards();
      if (list.length === 0) return;
      const wrapped = ((index % list.length) + list.length) % list.length;
      const target = list[wrapped];
      const left = centered.matches
        ? (() => {
            const railRect = rail.getBoundingClientRect();
            const targetRect = target.getBoundingClientRect();
            const targetCenter =
              targetRect.left - railRect.left + rail.scrollLeft + targetRect.width / 2;
            return targetCenter - rail.clientWidth / 2;
          })()
        : target.offsetLeft - rail.offsetLeft;
      // The global reduced-motion CSS rule can't reach a JS scroll behaviour.
      rail.scrollTo({ left, behavior: reduced.matches ? 'auto' : 'smooth' });
    };

    for (const btn of wrap.querySelectorAll<HTMLButtonElement>('[data-rail-scroll]')) {
      btn.addEventListener('click', () => {
        const dir = Number(btn.dataset.railScroll ?? '1');
        const list = cards();
        if (list.length === 0) return;
        const gap = Number.parseFloat(getComputedStyle(rail).columnGap) || 0;
        // Step by however many cards are fully visible at once, so one click
        // advances a full "screen" rather than nudging by a single card.
        const cardSpan = list[0].getBoundingClientRect().width + gap;
        const visible = Math.max(1, Math.round(rail.clientWidth / cardSpan));
        scrollToIndex(currentIndex() + dir * visible);
      });
    }
  }
</script>
