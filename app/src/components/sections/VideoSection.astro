---
import SectionHeading from '../ui/SectionHeading.astro';
import VideoCard from '../media/VideoCard.astro';
import { translator } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';
import { getVideoSection, getVideos } from '../../utils/content';

interface Props {
  locale: Locale;
  label?: string;
}

const { locale, label } = Astro.props;
const data = await getVideoSection(locale);
const videos = await getVideos(locale);
const t = translator(locale).video;

/**
 * Layout differs only in how each card is sized: a capped grid cell, or a
 * viewport-relative rail slide. VideoCard owns everything else.
 *
 * RAIL_CARD widths are computed, not approximated: each breakpoint fixes how
 * many cards are visible at once and the width formula
 * `calc((100% - (n-1)*gap) / n)` divides the rail's content box evenly across
 * exactly that many cards, so they tile edge-to-edge with no partial card
 * peeking in — matching gap-4 (1rem) on the <ul> below.
 *
 * Below `sm` only one card is visible and it must sit centered on screen.
 * Centering is done with the rail's own `px-8` padding + `snap-center` on the
 * card — NOT `justify-center`, which on an overflowing flex rail shoves the
 * first cards past the unreachable left edge (a data-loss alignment bug).
 * The mobile width is viewport-relative (`100vw-4rem`) so it lands exactly
 * between the two 2rem gutters; % would resolve against the padded content
 * box and end up off-center. From `sm` up, cards tile flush with
 * `justify-start` + `snap-start`.
 */
const GRID_CARD = 'aspect-[9/16] w-full max-w-[380px] mx-auto';
const RAIL_CARD =
  'aspect-[9/16] w-[calc(100vw-4rem)] snap-center sm:w-[calc((100%-1rem)/2)] sm:snap-start lg:w-[calc((100%-2rem)/3)] xl:w-[calc((100%-3rem)/4)] 2xl:w-[calc((100%-4rem)/5)] shrink-0';
---

<section
  id="videos"
  aria-labelledby="videos-heading"
  class="w-full overflow-x-hidden bg-brand-black text-white"
>
  <div class="shell pt-16 sm:pt-20 lg:pt-24">
    <SectionHeading
      id="videos-heading"
      label={label}
      heading={data.heading}
      intro={data.intro}
      tone="light"
    />
  </div>

  <div class="w-full pb-16 sm:pb-20 lg:pb-24">
    <!--
      GRID: more columns on large screens. Scroll rail: arrows are sm-and-up
      only — on phones a finger swipe is the native gesture and the arrows
      would cover the centered card's gutters.
    -->
    {
      videos.length === 0 ? (
        <div class="shell">
          <p class="mt-10 text-white/50">—</p>
        </div>
      ) : data.layout === 'grid' ? (
        <ul
          role="list"
          class="mt-10 grid grid-cols-2 gap-3 px-4 sm:px-6 md:grid-cols-3 lg:grid-cols-4 lg:gap-6 lg:px-8 xl:grid-cols-5 2xl:grid-cols-6"
          data-videos
        >
          {videos.map((video, index) => (
            <VideoCard video={video} locale={locale} cardId={`grid-${index}`} class={GRID_CARD} />
          ))}
        </ul>
      ) : (
        <div class="relative mt-10 w-full" data-video-rail-wrap>
          <button
            type="button"
            data-rail-scroll="-1"
            aria-label={t.prev}
            class="absolute top-1/2 left-2 z-20 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/20 bg-black/40 backdrop-blur-md transition-all duration-300 hover:scale-110 hover:bg-black/60 sm:left-4 sm:flex sm:h-12 sm:w-12 lg:left-6"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              class="h-6 w-6"
              fill="transparent"
              stroke="black"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M17.5 12.5 25 20l-7.5 7.5" />
            </svg>
          </button>
          <button
            type="button"
            data-rail-scroll="1"
            aria-label={t.next}
            class="absolute top-1/2 right-2 z-20 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/20 bg-black/40 backdrop-blur-md transition-all duration-300 hover:scale-110 hover:bg-black/60 sm:right-4 sm:flex sm:h-12 sm:w-12 lg:right-6"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              class="h-6 w-6"
              fill="transparent"
              stroke="black"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M6.5 11.5 25 25l7.5-7.5" />
            </svg>
          </button>

          <ul
            role="list"
            data-videos
            data-rail
            tabindex="0"
            aria-label={t.railLabel}
            class="no-scrollbar flex snap-x snap-mandatory justify-start gap-4 overflow-x-auto scroll-smooth px-8 pb-2"
          >
            {videos.map((video, index) => (
              <VideoCard video={video} locale={locale} cardId={`rail-${index}`} class={RAIL_CARD} />
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-videos]')) {
    for (const card of root.querySelectorAll<HTMLElement>('[data-video-card]')) {
      const video = card.querySelector<HTMLVideoElement>('video[data-video]');
      const playBtn = card.querySelector<HTMLButtonElement>('[data-play-toggle]');
      const muteBtn = card.querySelector<HTMLButtonElement>('[data-mute-toggle]');
      const detailsBtn = card.querySelector<HTMLButtonElement>('[data-details-toggle]');
      const muteLines = card.querySelectorAll<SVGLineElement>('[data-mute-line]');
      if (!video || !playBtn) continue;

      // Keeps the DOM state and the accessible names in step. Labels come from
      // data-* attributes so this script stays free of user-facing strings.
      const sync = () => {
        const playing = !video.paused && !video.ended;
        card.dataset.playing = String(playing);
        muteLines.forEach((line) => {
          line.style.display = video.muted ? 'block' : 'none';
        });

        const playLabel = playBtn.dataset[playing ? 'labelPause' : 'labelPlay'];
        if (playLabel) playBtn.setAttribute('aria-label', playLabel);

        if (muteBtn) {
          const muteLabel = muteBtn.dataset[video.muted ? 'labelUnmute' : 'labelMute'];
          if (muteLabel) muteBtn.setAttribute('aria-label', muteLabel);
        }
      };

      video.addEventListener('play', sync);
      video.addEventListener('pause', sync);

      playBtn.addEventListener('click', () => {
        if (!video.paused) {
          card.dataset.intent = 'pause';
          video.pause();
        } else {
          card.dataset.intent = 'play';
          video.play().catch(() => {});
        }
      });

      muteBtn?.addEventListener('click', () => {
        video.muted = !video.muted;
        sync();
      });

      detailsBtn?.addEventListener('click', () => {
        const open = detailsBtn.getAttribute('aria-expanded') !== 'true';
        detailsBtn.setAttribute('aria-expanded', String(open));
        card.dataset.open = String(open);
        const label = detailsBtn.dataset[open ? 'labelHide' : 'labelShow'];
        if (label) detailsBtn.setAttribute('aria-label', label);
      });

      sync();

      // Viewport autoplay, TikTok-style: play (muted — the element carries
      // muted+playsinline, which every mobile browser permits without a
      // gesture) once the card is mostly on screen, pause when it leaves.
      // An explicit pause by the visitor (data-intent) wins until they tap
      // play again, and reduced-motion visitors get no autoplay at all.
      // This replaces the old hover-only preview so touch devices behave
      // exactly like desktop.
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.intersectionRatio >= 0.5) {
                if (video.paused && card.dataset.intent !== 'pause' && !reducedMotion.matches) {
                  video.play().catch(() => {});
                }
              } else {
                if (!video.paused) video.pause();
              }
            }
          },
          { threshold: [0.5] },
        ).observe(card);
      }
    }
  }

  // ------------------------------------------------------------------
  // Endless rail navigation: index-based rather than raw pixel scrollBy,
  // so "next" past the last card wraps to the first (and vice versa)
  // instead of stopping — the arrows are always active, never disabled.
  // ------------------------------------------------------------------
  for (const wrap of document.querySelectorAll<HTMLElement>('[data-video-rail-wrap]')) {
    const rail = wrap.querySelector<HTMLElement>('[data-rail]');
    if (!rail) continue;

    const cards = () => Array.from(rail.querySelectorAll<HTMLElement>('[data-video-card]'));

    // Which card the rail is currently parked closest to, used as the base
    // for the next/prev step so a manual swipe stays in sync with the arrows.
    const currentIndex = () => {
      const list = cards();
      if (list.length === 0) return 0;
      let closest = 0;
      let closestDist = Infinity;
      list.forEach((card, i) => {
        const dist = Math.abs(card.offsetLeft - rail.offsetLeft - rail.scrollLeft);
        if (dist < closestDist) {
          closestDist = dist;
          closest = i;
        }
      });
      return closest;
    };

    // Below `sm` the visible card is center-snapped with margin either side
    // (see RAIL_CARD); from `sm` up, cards tile flush against the row start.
    // The scroll target math has to match whichever mode is active, or the
    // programmatic scroll lands short/long of where CSS snap actually settles.
    const centered = window.matchMedia('(max-width: 639.98px)');

    const scrollToIndex = (index: number) => {
      const list = cards();
      if (list.length === 0) return;
      const wrapped = ((index % list.length) + list.length) % list.length;
      const target = list[wrapped];
      const left = centered.matches
        ? (() => {
            const railRect = rail.getBoundingClientRect();
            const targetRect = target.getBoundingClientRect();
            const targetCenter =
              targetRect.left - railRect.left + rail.scrollLeft + targetRect.width / 2;
            return targetCenter - rail.clientWidth / 2;
          })()
        : target.offsetLeft - rail.offsetLeft;
      // The global reduced-motion CSS rule can't reach a JS scroll behaviour.
      rail.scrollTo({ left, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
    };

    for (const btn of wrap.querySelectorAll<HTMLButtonElement>('[data-rail-scroll]')) {
      btn.addEventListener('click', () => {
        const dir = Number(btn.dataset.railScroll ?? '1');
        const list = cards();
        if (list.length === 0) return;
        const gap = Number.parseFloat(getComputedStyle(rail).columnGap) || 0;
        // Step by however many cards are fully visible at once, so one click
        // advances a full "screen" rather than nudging by a single card.
        const cardSpan = list[0].getBoundingClientRect().width + gap;
        const visible = Math.max(1, Math.round(rail.clientWidth / cardSpan));
        scrollToIndex(currentIndex() + dir * visible);
      });
    }
  }
</script>
