---
import SectionHeading from '../ui/SectionHeading.astro';
import VideoCard from '../media/VideoCard.astro';
import { translator } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';
import { getVideoSection, getVideos } from '../../utils/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const data = await getVideoSection(locale);
const videos = await getVideos(locale);
const t = translator(locale).video;

/**
 * Layout differs only in how each card is sized: a capped grid cell, or a
 * viewport-relative rail slide. VideoCard owns everything else.
 *
 * RAIL_CARD widths are computed, not approximated: each breakpoint fixes how
 * many cards are visible at once and the width formula
 * `calc((100% - (n-1)*gap) / n)` divides the rail's content box evenly across
 * exactly that many cards, so they tile edge-to-edge with no partial card
 * peeking in — matching gap-4 (1rem) on the <ul> below.
 *
 * Below `sm` only one card is visible and it must sit centered on screen.
 * Centering is done with the rail's own `px-8` padding + `snap-center` on the
 * card — NOT `justify-center`, which on an overflowing flex rail shoves the
 * first cards past the unreachable left edge (a data-loss alignment bug).
 * The mobile width is viewport-relative (`100vw-4rem`) so it lands exactly
 * between the two 2rem gutters; % would resolve against the padded content
 * box and end up off-center.
 *
 * EVERY breakpoint is snap-center (rail.ts `center` mode): the active card
 * rides the midline with its neighbours peeking symmetrically, and when
 * every item fits the whole group centers instead — 1 item centered, 2 as
 * a symmetric pair, 3 with the middle card center. global.css owns both
 * halves of that: the first/last-card end margins that let the ends reach
 * the midline, and the justify-center switch that fires only when JS
 * measured no overflow.
 */
/*
 * `reveal` rides along on these same layout strings so VideoCard's root
 * (which merges the incoming `class` prop) picks up the scroll-driven
 * entrance from global.css without VideoCard needing to know about it.
 * The per-card stagger delay is applied separately, via nth-child on
 * [data-videos] in global.css, since it can't be threaded through a plain
 * class string.
 */
const GRID_CARD = 'aspect-[9/16] w-full max-w-[380px] mx-auto';
const RAIL_CARD =
  'aspect-[9/16] w-[calc(100vw-4rem)] snap-center sm:w-[calc((100%-1rem)/2)] lg:w-[calc((100%-2rem)/3)] xl:w-[calc((100%-3rem)/4)] 2xl:w-[calc((100%-4rem)/5)] shrink-0';

/**
 * A seamless loop needs duplicate content to scroll into. Three copies is
 * the minimum that lets the visitor travel a full copy-width in either
 * direction before rail.ts normalises, so the correction is never visible.
 *
 * Gated on a real minimum: looping two or three cards reads as a bug, not a
 * feature. Below the threshold the rail stays bounded (data-sets=1) and
 * behaves exactly as before. Tripling the DOM is safe only with the
 * playback controller's deferred sources + decoder budget already in place.
 */
const LOOP_MIN = 6;
const LOOP_SETS = 3;
const shouldLoop = data.layout !== 'grid' && videos.length >= LOOP_MIN;
const railItems = shouldLoop ? Array.from({ length: LOOP_SETS }, () => videos).flat() : videos;
---

<section
  id="videos"
  aria-labelledby="videos-heading"
  class="w-full overflow-x-hidden bg-brand-black text-white"
>
  <div class="shell pt-10 sm:pt-14 lg:pt-16">
    <div class="reveal">
      <SectionHeading id="videos-heading" heading={data.heading} intro={data.intro} tone="light" />
    </div>
  </div>

  <div class="w-full pb-10 sm:pb-14 lg:pb-16">
    <!--
      GRID: more columns on large screens. Scroll rail: arrows are sm-and-up
      only — on phones a finger swipe is the native gesture and the arrows
      would cover the centered card's gutters.
    -->
    {
      videos.length === 0 ? (
        <div class="shell">
          <p class="mt-10 text-white/50">—</p>
        </div>
      ) : data.layout === 'grid' ? (
        <ul
          role="list"
          class="mt-10 grid grid-cols-2 gap-3 px-4 sm:px-6 md:grid-cols-3 lg:grid-cols-4 lg:gap-6 lg:px-8 xl:grid-cols-5 2xl:grid-cols-6"
          data-videos
        >
          {videos.map((video) => (
            <VideoCard video={video} locale={locale} class={GRID_CARD} respectRatio />
          ))}
        </ul>
      ) : (
        <div
          class="relative mt-10 w-full"
          data-video-rail-wrap
          data-sets={shouldLoop ? LOOP_SETS : 1}
        >
          <button
            type="button"
            data-rail-scroll="-1"
            aria-label={t.prev}
            class="absolute top-1/2 left-2 z-20 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/20 bg-black/40 backdrop-blur-md transition-all duration-300 hover:scale-110 hover:bg-black/60 sm:left-4 sm:flex sm:h-12 sm:w-12 lg:left-6"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-6 w-6"
              fill="none"
              stroke="white"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M15 18l-6-6 6-6" />
            </svg>
          </button>
          <button
            type="button"
            data-rail-scroll="1"
            aria-label={t.next}
            class="absolute top-1/2 right-2 z-20 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/20 bg-black/40 backdrop-blur-md transition-all duration-300 hover:scale-110 hover:bg-black/60 sm:right-4 sm:flex sm:h-12 sm:w-12 lg:right-6"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-6 w-6"
              fill="none"
              stroke="white"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M9 18l6-6-6-6" />
            </svg>
          </button>

          <ul
            role="list"
            data-videos
            data-rail
            tabindex="0"
            aria-label={t.railLabel}
            class="no-scrollbar flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-8 pb-2"
          >
            {railItems.map((video, index) => {
              // Only the middle copy is real as far as assistive tech and
              // keyboard focus are concerned; the clones are decorative
              // duplicates. inert (not just aria-hidden) — aria-hidden does
              // NOT block pointer events. Clones render poster-only (no
              // <video>) — the media-element weight of the 3x loop was the
              // heaviest thing on the page.
              const isClone = shouldLoop && Math.floor(index / videos.length) !== 1;
              return (
                <VideoCard
                  video={video}
                  locale={locale}
                  class={RAIL_CARD}
                  posterOnly={isClone}
                  aria-hidden={isClone ? 'true' : undefined}
                  inert={isClone ? true : undefined}
                />
              );
            })}
          </ul>
        </div>
      )
    }
  </div>
</section>

<script>
  import { initRails } from '../../scripts/rail';
  import { initVideoPlayback } from '../../scripts/video-playback';

  // Shared rail navigation (arrows, snap-aware targets, optional loop) and
  // the centralised autoplay controller (top-N visible cards, deferred
  // sources, decoder budget, and — via delegated capture listeners — all
  // per-card presentation wiring) live in src/scripts/. Media events don't
  // bubble but DO traverse the capture path, so the controller syncs every
  // card's state through one funnel; this script stays O(1) no matter how
  // many cards or loop copies the section renders. `center` puts the rail
  // in center mode: the active card rides the midline, arrows step one
  // card and exist only while there is something to reach.
  initRails({ wrap: '[data-video-rail-wrap]', card: '[data-video-card]', center: true });
  initVideoPlayback();
</script>
