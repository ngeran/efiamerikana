---
import type { FooterData } from '../../content.config';
import { translator } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';

interface Props {
  data: FooterData;
  locale: Locale;
}

const { data, locale } = Astro.props;
const t = translator(locale).footer;

const year = new Date().getFullYear();
---

<footer class="w-full border-t border-white/10 bg-charcoal text-cream/70">
  <div
    class="shell flex flex-col items-center justify-between gap-4 py-8 text-center sm:flex-row sm:text-left"
  >
    <p class="font-label text-xs tracking-[0.2em] uppercase">
      © {year} EFIAMERIKANA · {t.allRightsReserved}
    </p>

    {
      data.note && (
        <p class="font-label text-xs tracking-[0.18em] text-brand-pink uppercase">{data.note}</p>
      )
    }
  </div>
</footer>
