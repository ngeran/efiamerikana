---
import { getImage } from 'astro:assets';
import MediaFrame from './MediaFrame.astro';
import { translator } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';
import type { VideoData } from '../../content.config';
import { autoPosterFor, resolveImage, resolveVideo } from '../../utils/media';

/**
 * Portrait short-form video card — the single source of truth for both the
 * grid and the rail layout in VideoSection. The two layouts differ only in
 * the <li> sizing classes, so that is a prop; everything else is shared.
 *
 * Interaction model:
 *  - MOUSE: hovering the card plays it; leaving pauses it (unless the
 *    autoplay controller already owns the card as a winner). Mouse clicks
 *    on the surface do nothing.
 *  - KEYBOARD: the surface stays a real button — Enter/Space toggles
 *    play/pause (a click with event.detail === 0 is a keyboard activation).
 *  - TOUCH: the autoplay controller owns playback (top-N visible cards);
 *    taps do nothing.
 *  - audio starts muted; unmuting is a separate explicit button (browsers
 *    block autoplay with sound, and surprise audio is hostile)
 *  - title/description/transcript are always visible on the gradient —
 *    the old +/x reveal toggle is gone
 *
 * Localized labels are passed down as data-* attributes so the playback
 * controller (src/scripts/video-playback.ts) stays free of user-facing
 * strings.
 */
interface Props extends astroHTML.JSX.HTMLAttributes {
  video: VideoData;
  locale: Locale;
  /** Layout-specific <li> sizing (grid cell vs rail slide). */
  class: string;
  /**
   * Grid-only: honour the video's authored orientation instead of the
   * layout's fixed slot. The rail never sets this — equal card heights are
   * what snap alignment and the arrow stepping assume.
   */
  respectRatio?: boolean;
  /**
   * Loop clones (copies 0/2 of the infinite rail) render POSTER-ONLY: no
   * <video>, no deferred source, no media element ever — clones hold zero
   * media bytes and no decoder slot at any point in the loop. The chrome
   * (buttons, tag, details) stays so the cards look identical to the middle
   * copy while the rail crosses a seam; they are inert regardless.
   */
  posterOnly?: boolean;
}

const {
  video,
  locale,
  class: className,
  respectRatio = false,
  posterOnly = false,
  // Loop clones pass aria-hidden + inert through here; anything else the
  // section may add lands on the root untouched.
  ...rest
} = Astro.props;
const t = translator(locale).video;

/** Authored orientation → grid card ratio (rail slots stay fixed). */
const RATIOS = { portrait: '9 / 16', landscape: '16 / 9', square: '1 / 1' } as const;
const ratio = RATIOS[video.orientation];
/**
 * Intrinsic dimensions matching each ratio — only the pre-metadata aspect
 * ratio is load-bearing (CSS sizes the element); real values arrive with
 * the video's own metadata. 576×1024 matches the actual ladder assets.
 */
const DIMS = {
  portrait: [576, 1024],
  landscape: [1024, 576],
  square: [720, 720],
} as const;
const [dimW, dimH] = DIMS[video.orientation];

const src = resolveVideo(video.video);
// '' means the referenced file is missing (failed upload) — render poster-only.
const missing = src === '';

/**
 * The poster ships as a LAZY `<img>` overlay rather than `<video poster>`:
 * Chromium fetches poster attributes at render time with no viewport check,
 * so a below-the-fold section pulled every poster at page load — tripled in
 * the rail loop. `loading="lazy"` defers each overlay until near-viewport,
 * and fading it out on first 'playing' (the section script latches
 * `data-started`) doubles as the Safari poster→first-frame flash fix: the
 * element keeps its last rendered frame once started, so the overlay never
 * returns.
 *
 * The overlay still needs a URL string, so <Image> can't be used — reading
 * `.src` off the import would serve the ORIGINAL file. One entry's poster is a
 * 1668x2420 16-bit PNG (8.2MB) rendering into a card at most 380px wide, so
 * that bypass cost ~100x the bytes needed. getImage() runs the same transform
 * pipeline <Image> uses, which also covers any poster uploaded later.
 *
 * 760px = 2x the widest card (380px grid cell) for retina. SVG posters are
 * passed through untouched: rasterizing vector art only makes it heavier.
 *
 * A poster set in the CMS wins; otherwise we fall back to the generated
 * first-frame still (autoPosterFor) so the card is never a black box while
 * paused — critical on touch devices where nothing hovers to start playback.
 */
const posterImage = video.poster ? resolveImage(video.poster) : autoPosterFor(video.video);
const posterSrc = posterImage
  ? posterImage.format === 'svg'
    ? posterImage.src
    : (await getImage({ src: posterImage, width: 760, format: 'webp' })).src
  : undefined;

const playLabel = `${t.play} — ${video.title}`;
const pauseLabel = `${t.pause} — ${video.title}`;
---

<li
  {...rest}
  class={`group relative overflow-hidden rounded-[18px] bg-black shadow-xl ${className}`}
  data-video-card
  data-playing="false"
  data-muted="true"
  style={respectRatio ? `--card-ratio: ${ratio};` : undefined}
>
  <!--
    width/height give the element its intrinsic ratio before any metadata
    loads. preload="metadata" costs only the moov atom (~50-150KB) once the
    playback controller attaches a source NEAR the viewport — duration and
    dimensions are then ready instantly at play() time, and the browser can
    begin streaming the first frames while the visitor is still scrolling.

    The clip-path is a compositing guard, not styling: once the video
    starts decoding it gets its own GPU layer, and Chromium lets composited
    video escape the ancestor `border-radius + overflow-hidden` clip until
    some event forces a recomposite — corners paint square and the layer
    can draw offset (reads as a cut-off top), then self-heals on the next
    scroll. clip-path IS applied on the compositor, so it clips the
    accelerated layer reliably. It lives HERE — below the card root, whose
    scroll-driven reveal transform is what aggravates the escape — and the
    radius matches the card's rounded-[18px]. The card keeps its own
    overflow-hidden for the chrome (buttons, overlay) and its shadow.
  -->
  <MediaFrame backdrop={posterImage} fit="contain" class="[clip-path:inset(0_round_18px)]">
    {
      !posterOnly && (
        <video
          data-video
          aria-label={video.posterAlt || video.title}
          width={dimW}
          height={dimH}
          loop
          muted
          playsinline
          disablepictureinpicture
          disableRemotePlayback
          preload="metadata"
          class="h-full w-full object-contain"
        >
          {
            /* data-src, not src: the playback controller promotes it on demand,
               so page load still fetches zero video bytes (posters only). */
            !missing && <source data-src={src} type="video/mp4" />
          }
        </video>
      )
    }
    {
      /* Lazy poster overlay — see the poster note in the frontmatter. */
      posterSrc && (
        <img
          data-video-poster
          src={posterSrc}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          class="pointer-events-none absolute inset-0 h-full w-full object-contain transition-opacity duration-500 ease-[var(--ease-out-soft)] group-data-[started=true]:opacity-0"
        />
      )
    }
  </MediaFrame>

  {
    /* No video file, no play surface and no mute control — controls that
       silently do nothing read as a broken site, not a failed upload. */
    !missing && (
      <button
        type="button"
        data-play-toggle
        class="absolute inset-0 z-0 h-full w-full cursor-pointer"
        aria-label={playLabel}
        data-label-play={playLabel}
        data-label-pause={pauseLabel}
      />
    )
  }

  {
    !missing && (
      <button
        type="button"
        data-mute-toggle
        class="absolute top-3 left-3 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-white/10 backdrop-blur-md sm:h-9 sm:w-9"
        aria-label={t.unmute}
        data-label-mute={t.mute}
        data-label-unmute={t.unmute}
      >
        <svg
          viewBox="0 0 24 24"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M11 5L6 9H2v6h4l5 4V5z" />
          <line data-mute-line x1="23" y1="9" x2="17" y2="15" />
          <line data-mute-line x1="17" y1="9" x2="23" y2="15" />
        </svg>
      </button>
    )
  }
  {
    /* The tag chip died with the +/x toggle: the always-on overlay's
       transcript occupies the same bottom-left corner. */
  }

  <div
    class="media-overlay-gradient pointer-events-none absolute inset-0 flex flex-col justify-end p-5"
  >
    <h3 class="font-display text-base text-white">{video.title}</h3>
    {
      video.description && (
        <p class="mt-1 text-xs leading-relaxed text-white/70">{video.description}</p>
      )
    }
    {
      video.transcript && (
        /* pointer-events-auto: the transcript scrolls — the surrounding
           all-none overlay would otherwise make that impossible. */
        <p class="pointer-events-auto mt-2 max-h-24 overflow-y-auto text-[11px] leading-relaxed text-white/60">
          <span class="font-bold tracking-wide uppercase">{t.transcript}: </span>
          {video.transcript}
        </p>
      )
    }
  </div>
</li>
