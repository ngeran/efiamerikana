---
import { getImage } from 'astro:assets';
import { translator } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';
import type { VideoData } from '../../content.config';
import { resolveImage, resolveVideo } from '../../utils/media';

/**
 * Portrait short-form video card — the single source of truth for both the
 * grid and the rail layout in VideoSection. The two layouts differ only in
 * the <li> sizing classes, so that is a prop; everything else is shared.
 *
 * Interaction model:
 *  - the whole media surface is the play/pause control
 *  - audio starts muted; unmuting is a separate explicit button (browsers
 *    block autoplay with sound, and surprise audio is hostile)
 *  - the +/x button reveals title/description/transcript (touch-friendly;
 *    hover-capable pointers also get a hover preview from the section script)
 *
 * Localized labels are passed down as data-* attributes so the section's
 * behaviour script stays free of user-facing strings.
 */
interface Props {
  video: VideoData;
  locale: Locale;
  /** Unique across the page — grid and rail must not collide on DOM ids. */
  cardId: string;
  /** Layout-specific <li> sizing (grid cell vs rail slide). */
  class: string;
}

const { video, locale, cardId, class: className } = Astro.props;
const t = translator(locale).video;

const src = resolveVideo(video.video);
// '' means the referenced file is missing (failed upload) — render poster-only.
const missing = src === '';

/**
 * `<video poster>` needs a URL string, so <Image> can't be used — but reading
 * `.src` off the import would serve the ORIGINAL file. One entry's poster is a
 * 1668x2420 16-bit PNG (8.2MB) rendering into a card at most 380px wide, so
 * that bypass cost ~100x the bytes needed. getImage() runs the same transform
 * pipeline <Image> uses, which also covers any poster uploaded later.
 *
 * 760px = 2x the widest card (380px grid cell) for retina. SVG posters are
 * passed through untouched: rasterizing vector art only makes it heavier.
 *
 * If no poster is provided, the video will show a black background.
 */
const posterImage = video.poster ? resolveImage(video.poster) : null;
const posterSrc = posterImage
  ? posterImage.format === 'svg'
    ? posterImage.src
    : (await getImage({ src: posterImage, width: 760, format: 'webp' })).src
  : undefined;
const detailsId = `video-details-${cardId}`;

const playLabel = `${t.play} — ${video.title}`;
const pauseLabel = `${t.pause} — ${video.title}`;
---

<li
  class={`group relative overflow-hidden rounded-[18px] bg-black shadow-xl ${className}`}
  data-video-card
  data-playing="false"
  data-muted="true"
  data-open="false"
>
  <!--
    width/height give the element a 9:16 intrinsic ratio before any metadata
    loads — which, with preload="none", is not until the visitor hits play.
    preload="none" is the single biggest win here: 6 rail videos would each
    otherwise fetch metadata on page load.
  -->
  <video
    data-video
    src={missing ? undefined : src}
    poster={posterSrc}
    aria-label={video.posterAlt || video.title}
    width="1080"
    height="1920"
    loop
    muted
    playsinline
    preload="none"
    class="h-full w-full object-cover"></video>

  <button
    type="button"
    data-play-toggle
    class="absolute inset-0 z-0 h-full w-full cursor-pointer"
    aria-label={playLabel}
    data-label-play={playLabel}
    data-label-pause={pauseLabel}></button>

  <button
    type="button"
    data-mute-toggle
    class="absolute top-3 left-3 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-white/10 backdrop-blur-md sm:h-9 sm:w-9"
    aria-label={t.unmute}
    data-label-mute={t.mute}
    data-label-unmute={t.unmute}
  >
    <svg
      viewBox="0 0 24 24"
      class="h-4 w-4"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="M11 5L6 9H2v6h4l5 4V5z"></path>
      <line data-mute-line x1="23" y1="9" x2="17" y2="15"></line>
      <line data-mute-line x1="17" y1="9" x2="23" y2="15"></line>
    </svg>
  </button>

  <button
    type="button"
    data-details-toggle
    class="absolute top-3 right-3 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-black transition-transform duration-500 ease-[var(--ease-out-soft)] group-data-[open=true]:rotate-45 sm:h-9 sm:w-9"
    aria-expanded="false"
    aria-controls={detailsId}
    aria-label={t.showDetails}
    data-label-show={t.showDetails}
    data-label-hide={t.hideDetails}
  >
    <svg
      viewBox="0 0 24 24"
      class="h-4 w-4"
      fill="none"
      stroke="white"
      stroke-width="2.5"
      aria-hidden="true"
    >
      <line x1="12" y1="5" x2="12" y2="19"></line>
      <line x1="5" y1="12" x2="19" y2="12"></line>
    </svg>
  </button>

  {
    video.tag && (
      <span class="pointer-events-none absolute bottom-3 left-3 z-10 rounded-full bg-black/60 px-3 py-1 font-label text-[10px] font-bold tracking-[0.15em] text-white uppercase backdrop-blur-sm transition-opacity duration-500 ease-[var(--ease-out-soft)] group-data-[open=true]:opacity-0">
        {video.tag}
      </span>
    )
  }

  <div
    id={detailsId}
    class="media-overlay-gradient pointer-events-none absolute inset-0 flex translate-y-4 flex-col justify-end p-5 opacity-0 transition-[opacity,transform] duration-500 ease-[var(--ease-out-soft)] group-data-[open=true]:translate-y-0 group-data-[open=true]:opacity-100"
  >
    <h3 class="font-display text-base text-white">{video.title}</h3>
    {
      video.description && (
        <p class="mt-1 text-xs leading-relaxed text-white/70">{video.description}</p>
      )
    }
    {
      video.transcript && (
        <p class="mt-2 max-h-24 overflow-y-auto text-[11px] leading-relaxed text-white/60">
          <span class="font-bold tracking-wide uppercase">{t.transcript}: </span>
          {video.transcript}
        </p>
      )
    }
  </div>
</li>