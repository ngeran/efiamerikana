---
import { Image } from 'astro:assets';
import MediaFrame from './MediaFrame.astro';
import { translator } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';
import type { PictureData } from '../../content.config';
import { resolveImage } from '../../utils/media';

/**
 * Gallery picture card — the single source of truth for both the grid and the
 * rail layout in PicturesSection. The layouts differ only in <li> sizing and
 * in the responsive `sizes` hint (which must describe the real rendered width
 * or the browser downloads the wrong candidate), so both are props.
 *
 * The description is revealed by the +/x toggle. It stays in the DOM either
 * way so assistive tech and touch users are never cut off from it.
 */
interface Props {
  picture: PictureData;
  locale: Locale;
  /** Unique across the page — grid and rail must not collide on DOM ids. */
  cardId: string;
  /** Layout-specific <li> sizing (grid cell vs rail slide). */
  class: string;
  /** Responsive sizes hint matching this layout's rendered width. */
  sizes: string;
  /**
   * CMS-controlled. When false the visible "+" is replaced by a full-bleed
   * transparent button covering the card: hover/focus still previews the
   * metadata on pointer devices, and tap/Enter still toggles it everywhere
   * else. Hiding the control entirely would strand touch users, since
   * :hover never fires for them.
   */
  showDetailsButton?: boolean;
  /**
   * CMS-controlled. When true, metadata preview shows on hover/focus. When
   * false, metadata only appears when explicitly toggled. Defaults false.
   */
  enableHoverPreview?: boolean;
  /**
   * CMS-controlled. When false, clicking/tapping the card does nothing and
   * metadata remains hidden. When true, clicking reveals the metadata overlay.
   * Defaults false.
   */
  enableClickToReveal?: boolean;
  /**
   * Grid-only: honour the asset's own aspect ratio instead of the layout's
   * fixed slot, so a landscape upload is never cropped into a portrait slot.
   * The rail never sets this — equal card heights are what snap alignment
   * and the arrow stepping assume.
   */
  respectRatio?: boolean;
}

const {
  picture,
  locale,
  cardId,
  class: className,
  sizes,
  showDetailsButton = true,
  enableHoverPreview = false,
  enableClickToReveal = false,
  respectRatio = false,
} = Astro.props;
const t = translator(locale).pictures;

const image = resolveImage(picture.image);
// The asset's true ratio, straight off the build-time metadata. Emitted as
// --card-ratio (consumed in global.css) only when the grid asked for it.
const ratio = image.width && image.height ? `${image.width} / ${image.height}` : null;
const detailsId = `picture-details-${cardId}`;

const showLabel = `${t.showDescription} — ${picture.title}`;
const hideLabel = `${t.hideDescription} — ${picture.title}`;
---

<li
  class={`group relative overflow-hidden rounded-[18px] bg-black shadow-xl ${className}`}
  data-picture-card
  data-open="false"
  style={respectRatio && ratio ? `--card-ratio: ${ratio};` : undefined}
>
  <MediaFrame backdrop={image} fit="contain">
    <Image
      src={image}
      alt={picture.imageAlt ?? picture.title ?? ''}
      widths={[400, 800]}
      sizes={sizes}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-contain transition-transform duration-[600ms] ease-[var(--ease-out-soft)] group-focus-within:scale-[1.06] group-hover:scale-[1.06] group-data-[open=true]:scale-[1.06]"
    />
  </MediaFrame>

  {
    enableClickToReveal &&
      (showDetailsButton ? (
        <button
          type="button"
          data-picture-toggle
          class="absolute top-4 right-4 z-10 flex h-10 w-10 items-center justify-center rounded-full border border-white/20 bg-black transition-transform duration-500 ease-[var(--ease-out-soft)] group-data-[open=true]:rotate-45"
          aria-expanded="false"
          aria-controls={detailsId}
          aria-label={showLabel}
          data-label-show={showLabel}
          data-label-hide={hideLabel}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class="h-[22px] w-[22px]"
            fill="transparent"
            stroke="black"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M17.5 12.5 25 20l-7.5 7.5" />
          </svg>
        </button>
      ) : (
        /* No visible chrome, but still a real control: the card itself. */
        <button
          type="button"
          data-picture-toggle
          class="absolute inset-0 z-10 h-full w-full cursor-pointer"
          aria-expanded="false"
          aria-controls={detailsId}
          aria-label={showLabel}
          data-label-show={showLabel}
          data-label-hide={hideLabel}
        />
      ))
  }

  <!--
    Revealed by the toggle (data-open) OR by hover/focus-within when enabled.
    The hover path is a progressive enhancement so the metadata is still
    discoverable when the "+" is hidden; the toggle path is what makes it
    reachable by touch.
  -->
  <div
    id={detailsId}
    class={`media-overlay-gradient pointer-events-none absolute inset-0 flex translate-y-4 flex-col justify-end p-6 opacity-0 transition-[opacity,transform] duration-500 ease-[var(--ease-out-soft)] ${
      enableHoverPreview
        ? 'group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100'
        : ''
    } group-data-[open=true]:translate-y-0 group-data-[open=true]:opacity-100`}
  >
    <h3 class="font-display text-lg text-white">{picture.title}</h3>
    {picture.description && <p class="mt-1 text-sm text-white/70">{picture.description}</p>}
  </div>
</li>
