---
import { translator } from '../i18n/ui';
import { localize } from '../i18n/utils';
import { enabledLocales as locales } from '../i18n/config';

const t = translator('en');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{t.notFound.title} · efiamerikana</title>
    <style>
      :root {
        color-scheme: light;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #ffde59;
        color: #17130f;
        font-family: 'Cantarell', system-ui, sans-serif;
        text-align: center;
        padding: 2rem;
      }
      h1 {
        font-size: clamp(2.5rem, 8vw, 4.5rem);
        margin: 0 0 0.5rem;
        line-height: 1.05;
      }
      p {
        margin: 0 0 2rem;
        font-size: 1.125rem;
      }
      a {
        display: inline-block;
        background: #17130f;
        color: #ffde59;
        padding: 0.75rem 1.5rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.875rem;
      }
      a + a {
        margin-left: 0.75rem;
        background: transparent;
        color: #17130f;
        border: 2px solid #17130f;
      }
      a:focus-visible {
        outline: 3px solid #17130f;
        outline-offset: 3px;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>404 · {t.notFound.title}</h1>
      <p>{t.notFound.body}</p>
      {
        locales.map((locale) => (
          <a href={localize('/', locale)}>
            {t.notFound.backHome} ({locale.toUpperCase()})
          </a>
        ))
      }
    </main>
  </body>
</html>
