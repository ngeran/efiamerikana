---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../i18n/config';
import { isMainSection, sectionComponents, type MainSectionId } from '../../data/sections';
import { getSettings } from '../../utils/content';
import type { SettingsData } from '../../content.config';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale: Locale = locales.includes(lang as Locale) ? (lang as Locale) : locales[0];

const settings = await getSettings(locale);

type SettingsSection = SettingsData['sections'][number];
const mainSections = settings.sections.filter(
  (section): section is SettingsSection & { id: MainSectionId } =>
    section.enabled && isMainSection(section.id),
);
const footerEnabled = settings.sections.find((section) => section.id === 'footer')?.enabled ?? true;

const path = `/${locale}`;
---

<BaseLayout
  locale={locale}
  title={settings.siteTitle}
  description={settings.siteDescription}
  path={path}
  anchorBase=""
  spy
  showFooter={footerEnabled}
>
  {
    mainSections.map((section) => {
      const Section = sectionComponents[section.id];
      return <Section locale={locale} label={section.navLabel} />;
    })
  }
</BaseLayout>
