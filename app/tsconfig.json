{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "tests/**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "baseUrl": ".",
    "strictNullChecks": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
